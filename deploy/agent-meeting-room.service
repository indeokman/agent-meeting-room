[Unit]
Description=Agent Meeting Room & LLM Memory Benchmark Hub
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/agent-meeting-room
Environment="AMR_HOST=0.0.0.0"
Environment="AMR_PORT=8080"
Environment="AMR_AUTH_MODE=none"
ExecStart=/opt/agent-meeting-room/.venv/bin/python /opt/agent-meeting-room/run.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
